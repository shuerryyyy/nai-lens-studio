{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NAI 镜头台适配文件 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "name",
    "allowedUrls",
    "auth",
    "request",
    "response"
  ],
  "properties": {
    "format": {
      "const": "nai-lens-adapter"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 600
    },
    "allowedUrls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "format": "uri",
        "description": "完整HTTP(S)接口地址，不能包含账号、查询、片段或通配符"
      }
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "bearer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "header"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 96,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "imagePath",
            "encoding"
          ],
          "properties": {
            "format": {
              "const": "json"
            },
            "imagePath": {
              "type": "string",
              "description": "如data.0.b64_json或images.0"
            },
            "encoding": {
              "enum": [
                "base64",
                "url"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "enum": [
                "image",
                "zip"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "source",
            "type"
          ],
          "properties": {
            "target": {
              "type": "string"
            },
            "source": {
              "enum": [
                "model",
                "fullPrompt",
                "negativePrompt",
                "scenePrompt",
                "characterPrompt",
                "artistPrompt",
                "positivePrompt",
                "size",
                "width",
                "height",
                "steps",
                "scale",
                "sampler",
                "seed",
                "noiseSchedule",
                "transparentBg"
              ]
            },
            "type": {
              "enum": [
                "string",
                "number",
                "integer",
                "boolean"
              ]
            },
            "map": {
              "type": "object",
              "maxProperties": 40,
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "value"
          ],
          "properties": {
            "target": {
              "type": "string"
            },
            "value": {
              "oneOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}